{
  "name": "ayurvedham",
  "private": true,
  "type": "module",
  "description": "Ayurvedham encyclopedia: static site, no runtime dependencies. Dev dependencies are used only for tests.",
  "scripts": {
    "migrate": "node tools/extract-legacy.mjs",
    "validate": "node tools/validate.mjs",
    "test": "node tools/validate.mjs && node --test tests/*.test.mjs commerce/*.test.mjs",
    "test:browser": "python3 tests/browser_test.py",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "axe-core": "^4.14.1"
  }
}
